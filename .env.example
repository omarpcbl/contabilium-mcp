# =============================================================================
# ENTORNO PRINCIPAL / PRODUCCIÓN
# =============================================================================

# Credenciales de API Pública de Contabilium (Fallback opcional si no se usa token cifrado en URL)
CONTABILIUM_CLIENT_ID=tu_email@empresa.com
CONTABILIUM_CLIENT_SECRET=tu_api_key_privada

# País de operación por defecto: AR (Argentina), CL (Chile), UY (Uruguay)
CONTABILIUM_COUNTRY=AR

# 1. URL Base de Contabilium configurable en Vercel
# Si se deja vacío, se asigna automáticamente según CONTABILIUM_COUNTRY:
# - AR: https://rest.contabilium.com
# - CL: https://rest.contabilium.cl
# - UY: https://rest.contabilium.com.uy
# Puedes especificar un endpoint personalizado, proxy o mock:
CONTABILIUM_BASE_URL=https://rest.contabilium.com

# Clave maestra para cifrado de tokens efímeros AES-256-GCM
ENCRYPTION_SECRET=contabilium-mcp-secure-master-key-2026-default

# Máscara de protección y acceso restringido al Portal Web:
# Si no se define, el valor por defecto para el equipo es: contabilium2026
# Para desactivar la máscara y abrir el portal sin restricciones: PORTAL_ACCESS_SECRET=disabled
PORTAL_ACCESS_SECRET=contabilium2026


# =============================================================================
# 2. ENTORNO PARALELO / QA / PERMISOS DIFERENCIADOS (Privado para el equipo)
# =============================================================================

# Ruta del endpoint paralelo (por defecto: /qa)
# Endpoints resultantes: /qa/mcp (Streamable HTTP) y /qa/sse (SSE)
MCP_QA_PATH=/qa

# URL Base de Contabilium para el entorno paralelo/QA
# Permite apuntar a un ambiente de staging, QA, sandbox o mock independiente
CONTABILIUM_QA_BASE_URL=https://rest.contabilium.com

# Credenciales fijas para el MCP paralelo en Vercel (opcional):
# Si las configuras, Claude se puede conectar directamente a https://tu-app.vercel.app/qa/mcp
# sin necesidad de pasar tokens en la URL (?auth=).
CONTABILIUM_QA_CLIENT_ID=
CONTABILIUM_QA_CLIENT_SECRET=
CONTABILIUM_QA_COUNTRY=AR

# Clave secreta para proteger el acceso a la ruta de QA (opcional pero recomendado):
# Si se define, Claude y las peticiones deberán incluir ?key=tu_clave_secreta_qa o el header x-qa-secret
MCP_QA_SECRET=

# Nombre del servidor MCP reportado en el handshake para el entorno paralelo
MCP_QA_NAME=contabilium-mcp-qa

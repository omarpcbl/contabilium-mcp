# Credenciales de API Pública de Contabilium
# Obtén estos datos desde tu panel web en: Mi Cuenta > Datos de mi empresa > API

CONTABILIUM_CLIENT_ID=tu_email@empresa.com
CONTABILIUM_CLIENT_SECRET=tu_api_key_privada

# País de operación: AR (Argentina), CL (Chile), UY (Uruguay)
CONTABILIUM_COUNTRY=AR

# URL Base opcional (si se deja vacío, se asigna automáticamente según CONTABILIUM_COUNTRY)
# CONTABILIUM_BASE_URL=https://rest.contabilium.com
